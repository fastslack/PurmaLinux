 * ║                                                                              ║
 * ║     ██████╗  ██████╗ ███████╗██╗    Aurora Theme                             ║
 * ║     ██╔══██╗██╔═══██╗██╔════╝██║    PurmaLinux                               ║
 * ║     ██████╔╝██║   ██║█████╗  ██║    Application Launcher                     ║
 * ║     ██╔══██╗██║   ██║██╔══╝  ██║                                             ║
 * ║     ██║  ██║╚██████╔╝██║     ██║                                             ║
 * ║     ╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝                                             ║
 * ║                                                                              ║
 * ╚══════════════════════════════════════════════════════════════════════════════╝
 */

/* ═══════════════════════════════════════════════════════════════════════════════
   Aurora Color Palette
   ═══════════════════════════════════════════════════════════════════════════════ */
* {
    /* Deep space backgrounds */
    void:       #0a0e14;
    space:      #0d1117;
    nebula:     #161b22;
    cosmic:     #21262d;
    stardust:   #30363d;

    /* Text colors */
    moonlight:  #8b949e;
    starlight:  #c9d1d9;
    plasma:     #f0f6fc;

    /* Aurora accents */
    cyan:       #00d4ff;
    purple:     #a855f7;
    pink:       #ec4899;
    green:      #22c55e;
    yellow:     #f59e0b;
    red:        #ef4444;

    /* Functional */
    transparent: rgba(0, 0, 0, 0);
    background-color: @transparent;
    text-color: @plasma;

    /* Sizing */
    border-radius: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   Window
   ═══════════════════════════════════════════════════════════════════════════════ */
window {
    location: center;
    anchor: center;
    width: 650px;

    background-color: @space;
    border: 2px solid;
    border-color: @cosmic;
    border-radius: 16px;

    /* Glass effect shadow */
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

/* ═══════════════════════════════════════════════════════════════════════════════
   Main Container
   ═══════════════════════════════════════════════════════════════════════════════ */
mainbox {
    spacing: 0;
    children: [inputbar, message, listview, mode-switcher];
}

/* ═══════════════════════════════════════════════════════════════════════════════
   Input Bar
   ═══════════════════════════════════════════════════════════════════════════════ */
inputbar {
    background-color: @nebula;
    padding: 16px 20px;
    spacing: 12px;
    border-radius: 16px 16px 0 0;
    children: [prompt, entry, case-indicator];
}

prompt {
    background-color: @cyan;
    text-color: @void;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: bold;
}

entry {
    padding: 8px 12px;
    placeholder: "Search applications...";
    placeholder-color: @moonlight;
    cursor-color: @cyan;
}

case-indicator {
    padding: 8px;
    text-color: @moonlight;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   List View
   ═══════════════════════════════════════════════════════════════════════════════ */
listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 4px;
    padding: 12px;
    scrollbar: true;
    background-color: @space;
}

scrollbar {
    width: 4px;
    handle-width: 4px;
    handle-color: @stardust;
    border-radius: 4px;
    background-color: @cosmic;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   Elements (Items)
   ═══════════════════════════════════════════════════════════════════════════════ */
element {
    padding: 12px 16px;
    spacing: 16px;
    border-radius: 10px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: @transparent;
    text-color: @starlight;
}

element normal.urgent,
element alternate.urgent {
    background-color: rgba(239, 68, 68, 0.15);
    text-color: @red;
}

element normal.active,
element alternate.active {
    background-color: rgba(0, 212, 255, 0.1);
    text-color: @cyan;
}

element selected.normal {
    background-color: @nebula;
    text-color: @plasma;
    border: 2px solid;
    border-color: @cyan;
}

element selected.urgent {
    background-color: @red;
    text-color: @plasma;
}

element selected.active {
    background-color: @cyan;
    text-color: @void;
}

/* Element icon and text */
element-icon {
    size: 36px;
    cursor: inherit;
    border-radius: 8px;
}

element-text {
    vertical-align: 0.5;
    cursor: inherit;
    highlight: bold underline;
}

element-text selected {
    text-color: @plasma;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   Mode Switcher
   ═══════════════════════════════════════════════════════════════════════════════ */
mode-switcher {
    background-color: @nebula;
    padding: 12px;
    spacing: 8px;
    border-radius: 0 0 16px 16px;
}

button {
    padding: 10px 20px;
    border-radius: 8px;
    text-color: @moonlight;
    cursor: pointer;
}

button selected {
    background-color: @cosmic;
    text-color: @cyan;
    border: 1px solid;
    border-color: @cyan;
}

/* ═══════════════════════════════════════════════════════════════════════════════
   Message
   ═══════════════════════════════════════════════════════════════════════════════ */
message {
    padding: 12px;
    background-color: @nebula;
    border-bottom: 1px solid @cosmic;
}

textbox {
    text-color: @starlight;
    padding: 8px;
}

error-message {
    padding: 16px;
    background-color: rgba(239, 68, 68, 0.15);
    border: 1px solid @red;
    border-radius: 8px;
}
