[global]
    # ═══════════════════════════════════════════════════════════════════════════
    #  Display
    # ═══════════════════════════════════════════════════════════════════════════
    monitor = 0
    follow = keyboard

    # ═══════════════════════════════════════════════════════════════════════════
    #  Geometry - Floating notifications
    # ═══════════════════════════════════════════════════════════════════════════
    width = (300, 400)
    height = 200
    origin = top-right
    offset = 16x60
    scale = 0

    # ═══════════════════════════════════════════════════════════════════════════
    #  Progress Bar
    # ═══════════════════════════════════════════════════════════════════════════
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 350
    progress_bar_corner_radius = 3

    # ═══════════════════════════════════════════════════════════════════════════
    #  Appearance
    # ═══════════════════════════════════════════════════════════════════════════
    notification_limit = 6
    indicate_hidden = yes
    shrink = no

    separator_height = 0
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 16

    frame_width = 2
    frame_color = "#21262d"
    gap_size = 8

    separator_color = auto
    sort = yes
    idle_threshold = 120

    # ═══════════════════════════════════════════════════════════════════════════
    #  Typography
    # ═══════════════════════════════════════════════════════════════════════════
    font = JetBrains Mono Medium 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    # ═══════════════════════════════════════════════════════════════════════════
    #  Icons
    # ═══════════════════════════════════════════════════════════════════════════
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 48
    max_icon_size = 64
    icon_path = /usr/share/icons/Papirus-Dark/48x48/status/:/usr/share/icons/Papirus-Dark/48x48/devices/:/usr/share/icons/Papirus-Dark/48x48/apps/

    # ═══════════════════════════════════════════════════════════════════════════
    #  History
    # ═══════════════════════════════════════════════════════════════════════════
    sticky_history = yes
    history_length = 50

    # ═══════════════════════════════════════════════════════════════════════════
    #  Misc
    # ═══════════════════════════════════════════════════════════════════════════
    browser = /usr/bin/firefox -new-tab
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 14
    ignore_dbusclose = false

    # ═══════════════════════════════════════════════════════════════════════════
    #  Mouse Actions
    # ═══════════════════════════════════════════════════════════════════════════
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

# ═══════════════════════════════════════════════════════════════════════════════
#  Urgency Levels - Aurora Colors
# ═══════════════════════════════════════════════════════════════════════════════

[urgency_low]
    background = "#0d1117"
    foreground = "#c9d1d9"
    frame_color = "#30363d"
    highlight = "#00d4ff"
    timeout = 5
    default_icon = dialog-information

[urgency_normal]
    background = "#0d1117"
    foreground = "#f0f6fc"
    frame_color = "#00d4ff"
    highlight = "#00d4ff"
    timeout = 10
    default_icon = dialog-information

[urgency_critical]
    background = "#0d1117"
    foreground = "#f0f6fc"
    frame_color = "#ef4444"
    highlight = "#ef4444"
    timeout = 0
    default_icon = dialog-warning

# ═══════════════════════════════════════════════════════════════════════════════
#  App-Specific Rules
# ═══════════════════════════════════════════════════════════════════════════════

[purma-ai]
    appname = "Purma*"
    frame_color = "#a855f7"
    highlight = "#a855f7"
    timeout = 15
    default_icon = face-robot

[purma-success]
    summary = "*success*"
    frame_color = "#22c55e"
    highlight = "#22c55e"

[purma-warning]
    summary = "*warning*"
    frame_color = "#f59e0b"
    highlight = "#f59e0b"

[purma-error]
    summary = "*error*"
    frame_color = "#ef4444"
    highlight = "#ef4444"

# Volume/Brightness notifications
[volume]
    appname = "volume"
    history_ignore = yes
    timeout = 2

[brightness]
    appname = "brightness"
    history_ignore = yes
    timeout = 2

# Spotify/Media
[spotify]
    appname = "Spotify"
    frame_color = "#22c55e"

[media]
    appname = "mpd"
    frame_color = "#a855f7"

# Discord
[discord]
    appname = "Discord"
    frame_color = "#5865F2"

# Slack
[slack]
    appname = "Slack"
    frame_color = "#4A154B"

# Firefox
[firefox]
    appname = "Firefox"
    frame_color = "#FF7139"
