# ═══════════════════════════════════════════════════════════════════════════════
#  Variables
# ═══════════════════════════════════════════════════════════════════════════════
set $mod Mod4
set $alt Mod1

set $term kitty
set $menu rofi -show drun -theme ~/.config/rofi/aurora.rasi
set $browser firefox
set $files thunar
set $editor code

# ═══════════════════════════════════════════════════════════════════════════════
#  Aurora Color Palette
# ═══════════════════════════════════════════════════════════════════════════════
# Deep space backgrounds
set $void       #0a0e14
set $space      #0d1117
set $nebula     #161b22
set $cosmic     #21262d
set $stardust   #30363d

# Text colors
set $moonlight  #8b949e
set $starlight  #c9d1d9
set $plasma     #f0f6fc

# Aurora accents
set $cyan       #00d4ff
set $purple     #a855f7
set $pink       #ec4899
set $green      #22c55e
set $yellow     #f59e0b
set $red        #ef4444

# Gradient endpoints (for reference)
set $gradient1  #00d4ff
set $gradient2  #a855f7

# ═══════════════════════════════════════════════════════════════════════════════
#  Visual Design
# ═══════════════════════════════════════════════════════════════════════════════
font pango:JetBrains Mono Medium 10

# Gaps - spacious and modern
gaps inner 12
gaps outer 8
smart_gaps off

# Borders - clean and subtle
default_border pixel 3
default_floating_border pixel 3
smart_borders off
hide_edge_borders none

# Window colors           border     bg        text       indicator  child_border
client.focused            $cyan      $space    $plasma    $purple    $cyan
client.focused_inactive   $cosmic    $space    $moonlight $cosmic    $cosmic
client.unfocused          $void      $void     $moonlight $void      $void
client.urgent             $red       $red      $plasma    $red       $red
client.placeholder        $void      $void     $moonlight $void      $void
client.background         $void

# Title bar (hidden with pixel border, but styled for tabbed/stacking)
title_align center

# ═══════════════════════════════════════════════════════════════════════════════
#  Keybindings - Core
# ═══════════════════════════════════════════════════════════════════════════════
# Terminal
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec $term --class floating-term

# Kill
bindsym $mod+q kill
bindsym $alt+F4 kill

# Launcher
bindsym $mod+d exec $menu
bindsym $mod+r exec rofi -show run -theme ~/.config/rofi/aurora.rasi
bindsym $mod+w exec rofi -show window -theme ~/.config/rofi/aurora.rasi

# Applications
bindsym $mod+e exec $files
bindsym $mod+Shift+e exec $browser

# ═══════════════════════════════════════════════════════════════════════════════
#  Keybindings - Purma AI Suite
# ═══════════════════════════════════════════════════════════════════════════════
# Purma AI Chat
bindsym $mod+a exec ags -r "togglePurmaChat()"
bindsym $mod+Shift+a exec kitty --class purma-terminal -e ollama run purma

# Purma Flow (Workflow automation)
bindsym $mod+f exec ags -r "togglePurmaFlow()"
bindsym $mod+Shift+f exec ags -r "togglePurmaRecording()"

# Purma Bridge (AI Terminal)
bindsym $mod+b exec ags -r "togglePurmaBridge()"
bindsym $mod+Shift+b exec kitty --class purma-bridge -e purma-bridge

# Purma Pulse (System health)
bindsym $mod+p exec ags -r "togglePurmaPulse()"
bindsym $mod+Shift+p exec kitty --class system-monitor -e btop

# Purma Lens (Vision/OCR)
bindsym $mod+y exec ags -r "togglePurmaLens()"
bindsym $mod+Shift+y exec ags -r "purmaQuickCapture('region')"

# Purma Vault (Password Manager)
bindsym $mod+v exec ags -r "togglePurmaVault()"
bindsym $mod+Shift+v exec kitty --class purma-vault -e purma-vault-ctl

# Purma Scribe (Voice Assistant)
bindsym $mod+c exec ags -r "togglePurmaScribe()"
bindsym $mod+Shift+x exec notify-send "Purma Scribe" "Recording for 5 seconds..." && curl -X POST http://localhost:11435/scribe/quick?duration=5

# Purma Brain (Advanced AI - Cortex, Memory, Ghost, Agents)
bindsym $mod+i exec ags -r "togglePurmaBrain()"

# Purma Models (AI Model Manager) - Uses EWW
bindsym $mod+m exec eww open --toggle models-popup
bindsym $mod+Shift+m exec kitty --class purma-models -e purma models

# Purma Spaces (Context switching)
bindsym $mod+o exec purma-spaces-ctl toggle
bindsym $mod+Shift+o exec purma-spaces-ctl menu
bindsym $mod+bracketright exec purma-spaces-ctl next
bindsym $mod+bracketleft exec purma-spaces-ctl prev

# Quick Spaces
bindsym $mod+Ctrl+1 exec purma-spaces-ctl work
bindsym $mod+Ctrl+2 exec purma-spaces-ctl code
bindsym $mod+Ctrl+3 exec purma-spaces-ctl focus
bindsym $mod+Ctrl+4 exec purma-spaces-ctl gaming

# ═══════════════════════════════════════════════════════════════════════════════
#  Keybindings - Screenshots (Purma Lens)
# ═══════════════════════════════════════════════════════════════════════════════
bindsym Print exec ags -r "purmaQuickCapture('fullscreen')"
bindsym Shift+Print exec ags -r "purmaQuickCapture('region')"
bindsym $mod+Print exec ags -r "purmaQuickCapture('window')"
bindsym Ctrl+Print exec ags -r "togglePurmaLens()"

# ═══════════════════════════════════════════════════════════════════════════════
#  Keybindings - System
# ═══════════════════════════════════════════════════════════════════════════════
# Lock screen
bindsym $mod+Escape exec i3lock-color -c 0a0e14 --ring-color=00d4ff --keyhl-color=a855f7 --bshl-color=ef4444 --insidever-color=0a0e14 --ringver-color=22c55e --insidewrong-color=0a0e14 --ringwrong-color=ef4444 --line-color=00000000 --separator-color=00000000 --verif-color=f0f6fc --wrong-color=ef4444 --time-color=00d4ff --date-color=8b949e --layout-color=8b949e --greeter-color=c9d1d9 --ind-pos="w/2:h/2" --time-pos="w/2:h/2-80" --date-pos="w/2:h/2+80" --greeter-pos="w/2:h-80" --clock --indicator --time-str="%H:%M" --date-str="%A, %B %d" --greeter-text="PurmaLinux"

# Reload/Restart
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+Escape exec rofi -show power-menu -modi "power-menu:~/.config/rofi/scripts/power-menu.sh" -theme ~/.config/rofi/aurora-power.rasi

# ═══════════════════════════════════════════════════════════════════════════════
#  Keybindings - Navigation
# ═══════════════════════════════════════════════════════════════════════════════
# Focus (vim-style)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Focus (arrows)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows (vim-style)
bindsym $mod+Shift+h move left 40 px
bindsym $mod+Shift+j move down 40 px
bindsym $mod+Shift+k move up 40 px
bindsym $mod+Shift+l move right 40 px

# Move windows (arrows)
bindsym $mod+Shift+Left move left 40 px
bindsym $mod+Shift+Down move down 40 px
bindsym $mod+Shift+Up move up 40 px
bindsym $mod+Shift+Right move right 40 px

# Split orientation
bindsym $mod+backslash split h
bindsym $mod+minus split v
bindsym $mod+t split toggle

# Fullscreen
bindsym $mod+m fullscreen toggle
bindsym $mod+Shift+m fullscreen toggle global

# Layout
bindsym $mod+s layout stacking
bindsym $mod+Tab layout tabbed
bindsym $mod+n layout toggle split
bindsym $mod+Shift+n layout toggle all

# Float
bindsym $mod+space floating toggle
bindsym $mod+Shift+space focus mode_toggle

# Sticky
bindsym $mod+Shift+s sticky toggle

# Focus parent/child
bindsym $mod+u focus parent
bindsym $mod+Shift+u focus child

# Scratchpad
bindsym $mod+grave move scratchpad
bindsym $mod+Shift+grave scratchpad show

# ═══════════════════════════════════════════════════════════════════════════════
#  Workspaces
# ═══════════════════════════════════════════════════════════════════════════════
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Navigate workspaces
bindsym $mod+Ctrl+Left workspace prev
bindsym $mod+Ctrl+Right workspace next
bindsym $mod+Ctrl+h workspace prev
bindsym $mod+Ctrl+l workspace next
bindsym $alt+Tab workspace back_and_forth

# Move workspace to output
bindsym $mod+Ctrl+Shift+Left move workspace to output left
bindsym $mod+Ctrl+Shift+Right move workspace to output right

# ═══════════════════════════════════════════════════════════════════════════════
#  Resize Mode
# ═══════════════════════════════════════════════════════════════════════════════
mode "resize" {
    bindsym h resize shrink width 40 px
    bindsym j resize grow height 40 px
    bindsym k resize shrink height 40 px
    bindsym l resize grow width 40 px

    bindsym Left resize shrink width 40 px
    bindsym Down resize grow height 40 px
    bindsym Up resize shrink height 40 px
    bindsym Right resize grow width 40 px

    # Fine control with Shift
    bindsym Shift+h resize shrink width 10 px
    bindsym Shift+j resize grow height 10 px
    bindsym Shift+k resize shrink height 10 px
    bindsym Shift+l resize grow width 10 px

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+z mode "default"
}
bindsym $mod+z mode "resize"

# ═══════════════════════════════════════════════════════════════════════════════
#  Gaps Mode
# ═══════════════════════════════════════════════════════════════════════════════
mode "gaps" {
    bindsym plus gaps inner all plus 4
    bindsym minus gaps inner all minus 4
    bindsym Shift+plus gaps outer all plus 4
    bindsym Shift+minus gaps outer all minus 4

    bindsym 0 gaps inner all set 0; gaps outer all set 0
    bindsym d gaps inner all set 12; gaps outer all set 8
    bindsym m gaps inner all set 20; gaps outer all set 12
    bindsym l gaps inner all set 30; gaps outer all set 20

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+g mode "gaps"

# ═══════════════════════════════════════════════════════════════════════════════
#  Media Keys
# ═══════════════════════════════════════════════════════════════════════════════
# Volume
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && notify-send -h int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]+(?=%)' | head -1) -h string:x-dunst-stack-tag:volume "Volume"
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && notify-send -h int:value:$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po '[0-9]+(?=%)' | head -1) -h string:x-dunst-stack-tag:volume "Volume"
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness
bindsym XF86MonBrightnessUp exec brightnessctl set +10% && notify-send -h int:value:$(brightnessctl -m | cut -d',' -f4 | tr -d '%') -h string:x-dunst-stack-tag:brightness "Brightness"
bindsym XF86MonBrightnessDown exec brightnessctl set 10%- && notify-send -h int:value:$(brightnessctl -m | cut -d',' -f4 | tr -d '%') -h string:x-dunst-stack-tag:brightness "Brightness"

# Media
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioStop exec playerctl stop

# ═══════════════════════════════════════════════════════════════════════════════
#  Window Rules
# ═══════════════════════════════════════════════════════════════════════════════
# Floating windows
for_window [class="pavucontrol"] floating enable, resize set 800 600
for_window [class="lxappearance"] floating enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="feh"] floating enable
for_window [class="Gpick"] floating enable
for_window [class="floating-term"] floating enable, resize set 900 600
for_window [class="purma-terminal"] floating enable, resize set 800 600
for_window [class="purma-bridge"] floating enable, resize set 1000 700
for_window [class="purma-models"] floating enable, resize set 900 600
for_window [class="system-monitor"] floating enable, resize set 1200 800
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable

# Picture-in-picture
for_window [title="Picture-in-Picture"] floating enable, sticky enable, border pixel 0

# Steam
for_window [class="^Steam$"] floating enable
for_window [class="^Steam$" title="^Steam$"] floating disable

# File dialogs
for_window [window_role="GtkFileChooserDialog"] floating enable, resize set 1000 700

# Workspace assignments
assign [class="firefox"] $ws3
assign [class="chromium"] $ws3
assign [class="Code"] $ws2
assign [class="code-oss"] $ws2
assign [class="Slack"] $ws4
assign [class="discord"] $ws4

# ═══════════════════════════════════════════════════════════════════════════════
#  Autostart
# ═══════════════════════════════════════════════════════════════════════════════
exec --no-startup-id ~/.config/i3/autostart.sh
