<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">

  <menu id="apps-accessories-menu" label="Accesorios">
    <item label="Archivos"><action name="Execute"><command>thunar</command></action></item>
    <item label="Calculator"><action name="Execute"><command>gnome-calculator</command></action></item>
    <item label="Screenshot"><action name="Execute"><command>maim -s ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png</command></action></item>
  </menu>

  <menu id="apps-internet-menu" label="Internet">
    <item label="Firefox"><action name="Execute"><command>firefox</command></action></item>
    <item label="Chromium"><action name="Execute"><command>chromium</command></action></item>
  </menu>

  <menu id="apps-dev-menu" label="Desarrollo">
    <item label="VS Code"><action name="Execute"><command>code</command></action></item>
    <item label="Terminal"><action name="Execute"><command>kitty</command></action></item>
    <item label="Neovim"><action name="Execute"><command>kitty -e nvim</command></action></item>
  </menu>

  <menu id="apps-ai-menu" label="AI">
    <item label="Purma Chat"><action name="Execute"><command>purma-chat</command></action></item>
    <item label="Ollama Terminal"><action name="Execute"><command>kitty -e ollama run purma</command></action></item>
    <item label="Modelos"><action name="Execute"><command>kitty -e ollama list</command></action></item>
  </menu>

  <menu id="system-menu" label="Sistema">
    <item label="Configuración"><action name="Execute"><command>lxappearance</command></action></item>
    <item label="Audio"><action name="Execute"><command>pavucontrol</command></action></item>
    <item label="Monitor"><action name="Execute"><command>kitty -e btop</command></action></item>
    <separator/>
    <item label="Openbox Config"><action name="Execute"><command>obconf</command></action></item>
    <item label="Reconfigure"><action name="Reconfigure"/></item>
  </menu>

  <menu id="exit-menu" label="Salir">
    <item label="Bloquear"><action name="Execute"><command>i3lock -c 1a1b26</command></action></item>
    <separator/>
    <item label="Cerrar Sesión"><action name="Exit"/></item>
    <item label="Reiniciar"><action name="Execute"><command>systemctl reboot</command></action></item>
    <item label="Apagar"><action name="Execute"><command>systemctl poweroff</command></action></item>
  </menu>

  <!-- Root menu -->
  <menu id="root-menu" label="PurmaLinux">
    <item label="Terminal"><action name="Execute"><command>kitty</command></action></item>
    <item label="Archivos"><action name="Execute"><command>thunar</command></action></item>
    <item label="Purma AI"><action name="Execute"><command>purma-chat</command></action></item>
    <separator/>
    <menu id="apps-internet-menu"/>
    <menu id="apps-dev-menu"/>
    <menu id="apps-ai-menu"/>
    <menu id="apps-accessories-menu"/>
    <separator/>
    <menu id="system-menu"/>
    <menu id="exit-menu"/>
  </menu>

</openbox_menu>
