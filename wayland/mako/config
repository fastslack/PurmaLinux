# ═══════════════════════════════════════════════════════════════════
# PurmaLinux - Mako Notification Daemon
# Theme: Aurora
# ═══════════════════════════════════════════════════════════════════

# Behavior
sort=-time
layer=overlay
anchor=top-right
default-timeout=5000
ignore-timeout=0

# Appearance
font=JetBrains Mono 10
width=350
height=150
margin=12
padding=12
border-size=2
border-radius=12
icons=1
max-icon-size=48
icon-location=left

# Colors (Aurora theme)
background-color=#0d1117ee
text-color=#c9d1d9
border-color=#30363d
progress-color=over #00d4ff

# Urgency levels
[urgency=low]
border-color=#30363d
default-timeout=3000

[urgency=normal]
border-color=#00d4ff

[urgency=critical]
border-color=#ef4444
default-timeout=0

# PurmaLinux notifications
[app-name=purma-*]
border-color=#a855f7
background-color=#161b22ee

[app-name=purma-scribe]
border-color=#22c55e

[app-name=purma-vault]
border-color=#f59e0b

[app-name=purma-lens]
border-color=#00d4ff
